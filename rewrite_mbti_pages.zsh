#!/bin/zsh
set -e

mkdir -p types

dim_label() {
  case "$1" in
    I) echo "内向 I" ;;
    E) echo "外向 E" ;;
    S) echo "感觉 S" ;;
    N) echo "直觉 N" ;;
    T) echo "思维 T" ;;
    F) echo "情感 F" ;;
    J) echo "判断 J" ;;
    P) echo "感知 P" ;;
  esac
}

render_page() {
  local code="$1"
  local code_lc=$(printf "%s" "$code" | tr '[:upper:]' '[:lower:]')
  local c1=$(printf "%s" "$code" | cut -c1)
  local c2=$(printf "%s" "$code" | cut -c2)
  local c3=$(printf "%s" "$code" | cut -c3)
  local c4=$(printf "%s" "$code" | cut -c4)

  cat > "types/${code_lc}.html" <<EOF
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>${title}</title>
  <meta name="description" content="${subtitle}">
  <link rel="stylesheet" href="../styles.css">
  <style>
    :root{
      --bg:#f7f8fc;
      --card:#ffffff;
      --text:#1f2937;
      --muted:#6b7280;
      --line:#e5e7eb;
      --accent:#4f46e5;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
      background:var(--bg);
      color:var(--text);
      line-height:1.75;
    }
    .wrap{
      max-width:920px;
      margin:0 auto;
      padding:32px 20px 64px;
    }
    .topbar{
      margin-bottom:20px;
      font-size:14px;
    }
    .topbar a{
      color:var(--accent);
      text-decoration:none;
    }
    .hero,.section{
      background:var(--card);
      border:1px solid var(--line);
      border-radius:20px;
      padding:24px;
      margin-bottom:18px;
      box-shadow:0 8px 24px rgba(15,23,42,.04);
    }
    .eyebrow{
      display:inline-block;
      font-size:12px;
      color:var(--accent);
      background:#eef2ff;
      padding:6px 10px;
      border-radius:999px;
      margin-bottom:12px;
    }
    .h1{
      font-size:34px;
      line-height:1.2;
      font-weight:800;
      margin:0 0 10px;
    }
    .subtitle{
      font-size:18px;
      color:var(--muted);
      margin:0 0 16px;
    }
    .chips{
      display:flex;
      flex-wrap:wrap;
      gap:10px;
      margin-top:8px;
    }
    .chip{
      display:inline-flex;
      align-items:center;
      padding:8px 12px;
      border-radius:999px;
      border:1px solid var(--line);
      background:#fff;
      font-size:14px;
    }
    h2{
      margin:0 0 12px;
      font-size:22px;
      line-height:1.3;
    }
    p{
      margin:0;
      color:#374151;
    }
    ul{
      margin:0;
      padding-left:20px;
    }
    li{
      margin:8px 0;
      color:#374151;
    }
    .grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:18px;
    }
    @media (max-width: 760px){
      .grid{grid-template-columns:1fr}
      .h1{font-size:28px}
      .subtitle{font-size:16px}
    }
  </style>
</head>
<body>
  <main class="wrap">
    <div class="topbar"><a href="../index.html">← 返回首页</a></div>

    <section class="hero">
      <div class="eyebrow">MBTI 16 型人格详解</div>
      <div class="h1" id="typeTitle">${title}</div>
      <p class="subtitle">${subtitle}</p>
      <div class="chips">
        <span class="chip">$(dim_label "$c1")</span>
        <span class="chip">$(dim_label "$c2")</span>
        <span class="chip">$(dim_label "$c3")</span>
        <span class="chip">$(dim_label "$c4")</span>
      </div>
    </section>

    <section class="section">
      <h2>人格总览</h2>
      <p>${overview}</p>
    </section>

    <section class="section">
      <h2>核心优势</h2>
      <ul>
        ${strengths}
      </ul>
    </section>

    <section class="section">
      <h2>可能的盲点</h2>
      <ul>
        ${blindspots}
      </ul>
    </section>

    <section class="section">
      <h2>成长建议</h2>
      <p>${growth}</p>
    </section>

    <div class="grid">
      <section class="section">
        <h2>职业倾向</h2>
        <p>${work}</p>
      </section>

      <section class="section">
        <h2>人际关系</h2>
        <p>${relation}</p>
      </section>

      <section class="section">
        <h2>恋爱模式</h2>
        <p>${love}</p>
      </section>

      <section class="section">
        <h2>压力与应对</h2>
        <p>${stress}</p>
      </section>
    </div>
  </main>
</body>
</html>
EOF
}

for code in ENFJ INFJ ENFP INFP ENTP INTP ENTJ INTJ ESFJ ISFJ ESFP ISFP ESTP ISTP ESTJ ISTJ; do
  case "$code" in
    ENFJ)
      title="ENFJ｜主人公"
      subtitle="富有感染力、善于鼓舞他人、重视关系与成长的引导型人格。"
      overview="ENFJ 通常很擅长理解他人的情绪和需求，也愿意主动承担协调、支持与带动团队气氛的角色。他们重视价值感、使命感和人与人之间的联结，希望自己做的事情不仅有效，而且有意义。"
      strengths="<li>共情力强，能快速感知团队氛围和他人状态。</li><li>表达感染力高，擅长鼓舞、协调与推动合作。</li><li>目标感与责任感并存，愿意为整体结果投入精力。</li>"
      blindspots="<li>过度在意他人评价，容易让自己长期处在高消耗状态。</li><li>为了维持和谐而回避冲突，导致问题拖延。</li><li>有时会替别人承担过多责任，忽略自己的边界。</li>"
      growth="ENFJ 的成长重点，是在照顾他人之前先照顾好自己。学会建立边界、允许分歧存在、把“帮助别人”与“替别人负责”区分开，会让你更稳定，也更有持续影响力。"
      work="适合教育培训、人力资源、咨询、客户成功、市场沟通、品牌、公关、组织发展、项目协调等需要沟通、带动和整合资源的岗位。"
      relation="在关系中，ENFJ 往往很主动、很用心，也愿意记住细节并制造仪式感。他们希望彼此真诚交流、共同成长，不喜欢长期冷漠和疏离。"
      love="恋爱中的 ENFJ 通常投入度高、表达直接、愿意付出，也很看重情感回应。如果长期得不到确认，他们容易变得焦虑或过度揣测。"
      stress="当压力积累时，ENFJ 可能表现为情绪敏感、对关系变化过度警觉，或对自己要求过高。稳定作息、减少无效社交、把任务优先级写下来会有帮助。"
      ;;
    INFJ)
      title="INFJ｜倡导者"
      subtitle="理想主义而有洞察力，安静坚定、追求意义与深度连接的人格。"
      overview="INFJ 往往关注事物背后的动机、结构和长期影响。他们不一定高调，但内在信念通常很强，做事讲求价值一致，也希望自己能对人和环境带来更深层的正向改变。"
      strengths="<li>洞察力强，能看见表面现象背后的模式与动因。</li><li>价值感明确，做事有原则，不容易被短期噪音带偏。</li><li>在深度沟通、一对一支持和长期规划上往往表现出色。</li>"
      blindspots="<li>理想标准较高，容易对自己和环境失望。</li><li>不喜欢被打扰，长期压抑后可能突然情绪性抽离。</li><li>想得很深，但未必愿意及时表达，容易让人误解。</li>"
      growth="INFJ 需要练习把内在判断更早地表达出来，不必等到所有想法都打磨完再开口。与其追求完全正确，不如先让重要的人听见真实的你。"
      work="适合心理支持、研究、内容策划、品牌战略、教育、咨询、用户洞察、公益、组织发展等需要深度理解与长期视角的工作。"
      relation="INFJ 在关系中重质量胜过数量，喜欢有深度、有信任感的连接。他们表面克制，内心其实很在意是否被真正理解。"
      love="恋爱中的 INFJ 追求精神共鸣与价值契合，不喜欢肤浅与反复试探。确定关系后通常专一，但也需要独处空间来恢复能量。"
      stress="高压下的 INFJ 可能变得封闭、过度反思，甚至对外界失去耐心。写作、散步、减少信息输入、回到稳定节奏，能帮助他们重新找回清晰感。"
      ;;
    ENFP)
      title="ENFP｜竞选者"
      subtitle="热情有创意，善于发现可能性、点燃气氛并连接人与想法的人格。"
      overview="ENFP 通常充满活力，喜欢新鲜感和变化，也很擅长在复杂信息中看到新的组合方式。他们重视真诚、自发性和成长空间，希望生活与工作都保有活力和意义。"
      strengths="<li>创意丰富，能迅速产生新点子与新连接。</li><li>表达自然，容易拉近距离并激活团队气氛。</li><li>适应变化快，对新项目、新方向接受度高。</li>"
      blindspots="<li>容易同时铺开太多事情，导致后期收尾困难。</li><li>对重复、僵硬、低变化的环境耐受度低。</li><li>情绪和兴趣波动会直接影响执行稳定性。</li>"
      growth="ENFP 的关键成长点在于把灵感转成结构。不是减少创意，而是建立筛选机制：先选最重要的，再为它持续投入，这样你的优势才会真正变成成果。"
      work="适合内容创意、市场传播、品牌、媒体、教育、培训、用户运营、社区、咨询、创新项目等需要创意、沟通和推动变化的岗位。"
      relation="ENFP 在关系里通常热情直接，喜欢分享感受、想法和新体验。他们很重视真诚，也讨厌长期压抑和套路化互动。"
      love="恋爱中的 ENFP 往往浪漫、主动、愿意制造惊喜，也期待对方在情感上有真实回应。若关系变得僵化，他们可能会迅速失去投入感。"
      stress="压力大时，ENFP 可能表现为注意力分散、情绪起伏、逃避琐碎任务。把目标拆小、限制同时进行的事项、先完成一个最小闭环，会比一味逼自己更有效。"
      ;;
    INFP)
      title="INFP｜调停者"
      subtitle="温和真诚、富有想象力，重视内在价值与情感真实的人格。"
      overview="INFP 往往内心世界丰富，对价值、意义、美感和人性的感受很深。他们不一定外向，但通常有很强的理想色彩，希望以符合内心信念的方式生活和工作。"
      strengths="<li>真诚细腻，能感知微妙情绪和关系变化。</li><li>想象力与审美感较强，适合表达和创造。</li><li>价值驱动明显，一旦认定就会很投入。</li>"
      blindspots="<li>现实执行层面有时会被情绪和完美倾向拖慢。</li><li>不喜欢被强推或被控制，遇到压迫感容易退缩。</li><li>容易在心里反复打转，不愿及时求助。</li>"
      growth="INFP 的成长不在于变得冷硬，而在于建立更稳定的现实落点。把感受转成计划，把理想拆成步骤，你会更容易把内心的东西真正带到现实里。"
      work="适合写作、设计、内容创作、教育、心理支持、品牌叙事、用户体验、文化项目、公益和需要创意表达与价值感的岗位。"
      relation="INFP 在关系中很看重尊重、理解和情绪安全。他们不一定话多，但会通过记忆细节、长期在意和默默付出来表达重视。"
      love="恋爱中的 INFP 往往温柔、专一、重精神交流。他们不喜欢强控制和粗糙表达，更容易被真诚、稳定和愿意倾听的人吸引。"
      stress="长期高压下，INFP 可能会拖延、逃避现实任务，或者对自己特别苛刻。给自己明确节奏、降低一次性标准、先做完再优化，会更有帮助。"
      ;;
    ENTP)
      title="ENTP｜辩论家"
      subtitle="思维敏捷、点子很多，喜欢挑战旧框架并推动新可能的人格。"
      overview="ENTP 通常擅长从不同角度拆解问题，也乐于讨论、质疑和重组既有方案。他们往往不是为了争而争，而是享受通过碰撞想法来逼近更优解。"
      strengths="<li>反应快，善于发现漏洞、机会与替代路径。</li><li>创意与逻辑兼具，适合做开创和破局型工作。</li><li>面对变化与不确定性时，通常能保持弹性。</li>"
      blindspots="<li>容易对新鲜问题过度投入，对收尾耐心不足。</li><li>表达锋利时，可能让别人感到被挑战或被否定。</li><li>若缺乏约束，容易把思考停留在讨论层面。</li>"
      growth="ENTP 的成长重点，是提升落地能力和关系敏感度。你的优势是打开可能性，但真正拉开差距的，是把少数最好的想法推进到底。"
      work="适合战略、咨询、产品、创业、商业拓展、市场创新、内容策划、技术方案设计等需要快速思考与创造新路径的工作。"
      relation="ENTP 在关系里重视有趣、平等和脑力互动，喜欢和能聊、能接得住自己节奏的人相处。对过度僵化或情绪化的互动耐受度较低。"
      love="恋爱中的 ENTP 通常喜欢新鲜感和高质量交流，希望关系里既有吸引力也有成长性。如果觉得被束缚，他们会明显后撤。"
      stress="高压下的 ENTP 可能变得嘴硬、分心、不断切换方向。此时最有效的是先冻结选择，明确一件必须完成的事，再用时间块推进。"
      ;;
    INTP)
      title="INTP｜逻辑学家"
      subtitle="理性独立、热爱分析，善于构建模型与理解复杂系统的人格。"
      overview="INTP 往往对知识、原理、逻辑一致性有天然兴趣。他们喜欢独立思考，不满足于表面答案，更在意一件事是否真的说得通、是否具备可解释的结构。"
      strengths="<li>分析力强，擅长抽象、建模与系统化思考。</li><li>不盲从，愿意从根本逻辑重新检视问题。</li><li>学习快，对复杂知识和深度问题耐受度高。</li>"
      blindspots="<li>容易一直优化思路，导致决策和行动偏慢。</li><li>对低逻辑、低效率的协作场景容忍度不高。</li><li>表达时若只讲结论，别人可能跟不上你的推理链。</li>"
      growth="INTP 需要练习把“想明白”转成“让别人也明白”。适当外显推理过程、及时验证而非只在脑内推演，会让你的能力更容易被看见。"
      work="适合研究、数据分析、算法、产品策略、技术架构、咨询、内容研究、系统设计等需要逻辑推演和独立思考的岗位。"
      relation="INTP 在关系中需要空间和自由，不喜欢被高频打扰，但这不代表不在意。他们更倾向用持续关注和问题解决来表达重视。"
      love="恋爱中的 INTP 重视精神交流和相处舒适度，不太擅长高密度情绪表达，但一旦认定通常比较稳定。"
      stress="压力大时，INTP 可能进一步封闭、拖延执行、沉浸在信息搜集里。给自己设定明确截止点，先做最小验证，比继续想更有用。"
      ;;
    ENTJ)
      title="ENTJ｜指挥官"
      subtitle="目标清晰、执行果断，善于规划资源与推动结果达成的人格。"
      overview="ENTJ 通常对方向、效率、结构和成果有较强敏感度。他们喜欢掌控全局，擅长把复杂任务拆成路径并推动执行，面对模糊局面时也往往愿意先站出来做决策。"
      strengths="<li>战略感强，能从全局视角看目标与路径。</li><li>行动推进力高，适合带队和整合资源。</li><li>在压力环境下依然能保持决断与秩序。</li>"
      blindspots="<li>容易对低效率和反复沟通失去耐心。</li><li>过度强调结果时，可能忽略他人感受和节奏。</li><li>在不自觉时，会把“建议”表达成“命令”。</li>"
      growth="ENTJ 的升级关键，不是更强硬，而是更有层次地使用力量。把“推动结果”与“让人愿意跟随”结合起来，你的影响力会更大。"
      work="适合管理、战略、咨询、商业运营、项目统筹、创业、销售领导、产品决策等需要决策、推进和资源配置能力的岗位。"
      relation="ENTJ 在关系里通常直接、负责、讲效率，也愿意为长期目标投入。他们欣赏独立、有主见、能一起成长的人。"
      love="恋爱中的 ENTJ 重视承诺、稳定和未来规划，不喜欢模糊不清或反复拉扯。对他们来说，长期一致性比表面浪漫更重要。"
      stress="高压下的 ENTJ 可能变得更强势、更控制，也更难容忍失误。适时放权、保留休息窗口、给团队留反馈空间，会明显改善状态。"
      ;;
    INTJ)
      title="INTJ｜建筑师"
      subtitle="独立冷静、擅长长线规划，喜欢用系统方法实现目标的人格。"
      overview="INTJ 往往兼具战略思维与独立判断力。他们重视效率，但不是短线效率，而是更看重系统是否合理、路径是否可持续、结果是否符合长期布局。"
      strengths="<li>规划能力强，擅长构建中长期路径。</li><li>逻辑严谨，做决策时重视底层结构与证据。</li><li>自驱力高，不需要过多外部推动也能持续前进。</li>"
      blindspots="<li>容易显得疏离，别人未必能感受到你的善意。</li><li>对低质量讨论和无效流程耐受度较低。</li><li>若对环境失去信心，可能迅速抽离投入。</li>"
      growth="INTJ 的成长关键，在于让自己的高标准变得更可沟通。不是降低要求，而是让他人知道你的判断依据和合作边界。"
      work="适合战略规划、产品、研究、技术架构、数据、咨询、流程优化、商业分析等需要结构化与长期思考的岗位。"
      relation="INTJ 重视边界和尊重，不喜欢过度情绪消耗型关系。他们更愿意与能够理性交流、彼此信任的人建立长期连接。"
      love="恋爱中的 INTJ 通常慢热，但认真而稳定。他们未必高调表达，却会通过规划未来、解决问题和持续投入来体现重视。"
      stress="压力过大时，INTJ 可能表现为更封闭、更挑剔、对周围效率更加敏感。留出独处恢复时间、减少低价值社交，会很重要。"
      ;;
    ESFJ)
      title="ESFJ｜执政官"
      subtitle="热心周到、重视责任与关系，擅长照顾秩序与群体感受的人格。"
      overview="ESFJ 往往很在意团队是否和谐、事情是否妥当、每个人是否被照顾到。他们喜欢明确角色与责任，也愿意通过实际行动维持秩序、温度与合作感。"
      strengths="<li>责任心强，执行稳定，愿意把事情照顾到位。</li><li>关系感强，善于营造合作氛围与安全感。</li><li>对规则、礼貌和实际安排较为敏感，组织能力不错。</li>"
      blindspots="<li>容易过度在意外界反馈与认可。</li><li>不喜欢冲突，可能为了和谐压住真实想法。</li><li>面对突发变化时，容易因为失序而焦虑。</li>"
      growth="ESFJ 的成长重点，在于建立更清晰的自我边界。照顾别人是你的优势，但不是所有人的情绪都需要你负责。"
      work="适合行政、人力资源、客户服务、教育、医疗支持、运营、活动协调、社区管理等需要稳定协作和服务意识的岗位。"
      relation="ESFJ 通常非常重视关系维护，会主动联系、记住细节、安排实际支持。他们希望关系里有回应、有温度、有稳定感。"
      love="恋爱中的 ESFJ 往往投入、细腻、讲究仪式感，也很重视现实层面的可靠与承诺。忽冷忽热会让他们明显不安。"
      stress="高压下的 ESFJ 可能会变得焦虑、讨好、过度揣测别人态度。及时说出需求、把任务排优先级、避免一个人扛全部，会更稳。"
      ;;
    ISFJ)
      title="ISFJ｜守卫者"
      subtitle="安静细致、可靠体贴，重视责任、稳定与实际照顾的人格。"
      overview="ISFJ 往往不一定站在最前面，但在团队和关系中，他们经常是最稳定、最可靠的一类人。他们重视细节、承诺与长期关系，也很擅长默默把事情做好。"
      strengths="<li>细致踏实，能稳定完成高要求的具体工作。</li><li>体贴可靠，对人和事都愿意持续负责。</li><li>记忆细节能力较强，擅长维护长期秩序和信任。</li>"
      blindspots="<li>不擅长拒绝，容易把别人的需求放在自己前面。</li><li>遇到变化时可能先紧张，再慢慢适应。</li><li>真实情绪常常压在心里，不愿打扰别人。</li>"
      growth="ISFJ 需要练习更早表达自己的感受和边界。你不必等到非常难受时才开口，及时沟通反而能保护关系。"
      work="适合运营、行政、财务支持、教育、护理、医疗支持、客户服务、后勤协调、质量管理等需要耐心与稳定性的岗位。"
      relation="ISFJ 在关系里重承诺、重照顾、重长期，不喜欢表面化互动。他们表达爱的方式常常是记得、做到、持续在。"
      love="恋爱中的 ISFJ 温和、稳重、愿意付出，也很在意安全感和一致性。若长期被忽略，他们会慢慢失望而不是立刻爆发。"
      stress="压力大时，ISFJ 可能更压抑、更敏感，或者在细节上反复担心。规律作息、明确界限、减少额外承诺，会帮助他们恢复。"
      ;;
    ESFP)
      title="ESFP｜表演者"
      subtitle="外向活跃、感染力强，热爱体验、互动与当下生命力的人格。"
      overview="ESFP 通常很有现场感，善于感受气氛、调动情绪，也愿意把快乐和能量带给身边的人。他们重视真实体验，不喜欢过于僵硬和抽离的环境。"
      strengths="<li>感染力强，容易让场子热起来并拉近距离。</li><li>反应快，适应现场变化能力较好。</li><li>重体验、会行动，能把想法快速带到现实。</li>"
      blindspots="<li>长期做枯燥重复任务时，容易掉动力。</li><li>更关注当下感受，可能忽略长期规划。</li><li>在高刺激环境里容易分散精力。</li>"
      growth="ESFP 的成长点在于让热情更可持续。保留你的活力，但为关键目标建立一点规划和复盘，你会更容易把天赋转成长期成果。"
      work="适合市场活动、销售、内容、主持、教育、客户面对面岗位、娱乐行业、零售、社群运营等需要互动和现场感的工作。"
      relation="ESFP 在关系中通常热情直接，喜欢真实互动和共同体验。他们很讨厌冷处理、吊着不说和过度复杂化。"
      love="恋爱中的 ESFP 往往会主动表达喜欢，也愿意创造轻松、有趣、有温度的相处氛围。他们期待对方也能真诚投入。"
      stress="当压力过大时，ESFP 可能会用娱乐和分心来回避现实任务。最有效的方法是先处理一件最具体的小事，把节奏重新拉回来。"
      ;;
    ISFP)
      title="ISFP｜探险家"
      subtitle="温和敏锐、审美突出，追求真实体验与内在自由的人格。"
      overview="ISFP 往往低调但不空白，他们有自己很清晰的感受、品味和判断。相比高调表达，他们更倾向通过作品、行动、风格和体验来展现自我。"
      strengths="<li>感受力细腻，对美感、氛围与细节有天然敏感度。</li><li>温和不强迫，容易让人感到舒服和被尊重。</li><li>面对具体体验和实际行动时，适应性通常不错。</li>"
      blindspots="<li>不喜欢被控制，遇到强压时容易沉默或后撤。</li><li>对长期规划兴趣有限，可能边走边看。</li><li>真实想法不总是直接说出口，容易被低估。</li>"
      growth="ISFP 的成长重点，是让内在感受更可表达。你不需要变得高调，但把自己的标准、喜好和边界说清楚，会让生活更顺。"
      work="适合设计、摄影、视觉创作、品牌内容、手作、用户体验、教育支持、疗愈相关、需要审美和细致感受的岗位。"
      relation="ISFP 在关系中重视自然、舒服和真诚，不喜欢被操控或被强行定义。他们会用细节和陪伴表达重视。"
      love="恋爱中的 ISFP 通常温柔、细腻、慢热，喜欢自然流动的关系。若被逼得太紧，他们容易退回自己的空间。"
      stress="高压下的 ISFP 可能会沉默、拖延、逃避表达。此时比起讲大道理，更有用的是先让环境安静下来，再一步一步处理现实事务。"
      ;;
    ESTP)
      title="ESTP｜企业家"
      subtitle="行动迅速、胆识强，喜欢现场解决问题并抓住机会的人格。"
      overview="ESTP 往往反应快、决断快、进入状态也快。他们不喜欢空转，偏好通过真实行动获取反馈，对环境变化有较强应变能力，也经常能在混乱中找到机会。"
      strengths="<li>临场反应强，适合处理突发情况和现实问题。</li><li>行动导向明显，愿意直接试、直接做、直接验证。</li><li>在高变化、高节奏环境中往往有优势。</li>"
      blindspots="<li>容易低估长期规划和后续维护的重要性。</li><li>若过度追求刺激，可能忽略风险边界。</li><li>对过度繁琐、低反馈的流程耐受度不高。</li>"
      growth="ESTP 的进阶方向，不是削弱行动力，而是给行动配上更好的判断框架。多一步预判、多一点复盘，会让你更强。"
      work="适合销售、商务拓展、谈判、活动执行、现场运营、创业、交易、危机处理、需要高反应和高行动力的岗位。"
      relation="ESTP 在关系中通常直接、爽快、重感觉，也喜欢和能量高、反应快的人相处。他们不喜欢长期拧巴和复杂试探。"
      love="恋爱中的 ESTP 倾向于用行动表达好感，希望关系是有活力、有互动、有真实体验的。若感觉被束缚，他们会明显抗拒。"
      stress="压力大时，ESTP 可能会更冲动、更冒进，或者用忙碌掩盖真正问题。此时需要暂停一下，先看风险，再决定下一步。"
      ;;
    ISTP)
      title="ISTP｜鉴赏家"
      subtitle="冷静务实、动手能力强，擅长独立分析和解决实际问题的人格。"
      overview="ISTP 往往喜欢直接面对问题本身，而不是先陷入情绪和场面。他们善于观察、拆解和试验，遇到具体系统、工具、流程或结构性问题时，常常能找到有效解法。"
      strengths="<li>独立冷静，面对问题时不容易慌乱。</li><li>动手能力强，适合边试边修正。</li><li>注重效率和实际效果，反感空谈。</li>"
      blindspots="<li>不喜欢被过度管束，遇到控制感会迅速拉开距离。</li><li>表达情绪较少，别人未必知道你的真实在意。</li><li>若长期做重复社交型工作，容易耗能。</li>"
      growth="ISTP 的成长在于让自己不只是会解决问题，也能让别人理解你的判断。适度表达过程和感受，会让合作更顺畅。"
      work="适合工程、技术、运维、数据、产品测试、风控、流程优化、设备相关、问题排查等需要独立分析与实践能力的岗位。"
      relation="ISTP 在关系中需要空间和信任，不喜欢高控制、高黏着的互动。他们更看重实际相处质量，而不是表面热闹。"
      love="恋爱中的 ISTP 慢热、务实、不太会说漂亮话，但如果真的在意，通常会通过行动和稳定陪伴体现。"
      stress="高压时，ISTP 可能进一步沉默、抽离或只想一个人处理。此时让自己先回到熟悉任务和明确结构里，会更容易恢复。"
      ;;
    ESTJ)
      title="ESTJ｜总经理"
      subtitle="讲求秩序、执行有力，擅长组织资源与推动规则落地的人格。"
      overview="ESTJ 往往重视现实效率、责任边界和组织秩序。他们擅长把事情安排清楚、推进到位，也愿意为团队结果承担责任，是典型的执行和管理型人格。"
      strengths="<li>执行力强，能把事情迅速拉回正轨。</li><li>责任意识明确，擅长落实规则与标准。</li><li>组织能力较强，适合统筹任务与分工。</li>"
      blindspots="<li>容易对慢节奏、低标准和模糊表达失去耐心。</li><li>过度强调规则时，可能忽略个体差异与情绪。</li><li>在高压下会更强硬，沟通弹性下降。</li>"
      growth="ESTJ 的成长不在于放弃标准，而在于学会区分哪些事情必须严格，哪些事情可以更灵活。把力度用在关键处，效果会更好。"
      work="适合运营管理、项目管理、财务、行政、供应链、质量控制、团队管理、执行统筹等需要纪律和推进能力的岗位。"
      relation="ESTJ 在关系里通常很负责，也愿意投入时间和资源去维持稳定。他们看重靠谱、准时、兑现和现实承担。"
      love="恋爱中的 ESTJ 重视承诺与长期性，表达方式偏务实。对他们来说，稳定、计划和可依靠，比华丽表达更重要。"
      stress="压力大时，ESTJ 可能变得更急、更硬、更想直接接管一切。留出缓冲时间、避免连续高压决策，会让状态更平衡。"
      ;;
    ISTJ)
      title="ISTJ｜物流师"
      subtitle="稳重严谨、可靠负责，重视规则、秩序与长期一致性的人格。"
      overview="ISTJ 通常做事认真、讲原则、讲证据，偏好清晰流程与明确责任。他们不爱夸张表现，但在很多场景里，往往是最值得信赖、最能把事情踏实做完的人。"
      strengths="<li>稳定可靠，做事有条理且重视细节。</li><li>责任感强，能长期坚持并守住标准。</li><li>面对复杂任务时，适合按步骤稳步推进。</li>"
      blindspots="<li>对变化和不确定性天然更谨慎，切换速度可能偏慢。</li><li>不喜欢空泛表达，容易显得保守或不够热络。</li><li>若环境混乱无序，会明显增加内耗。</li>"
      growth="ISTJ 的升级方向，是在保留严谨的同时，增加对变化的弹性。不是放弃标准，而是学会在新情况里快速找到新的标准。"
      work="适合审计、财务、法务支持、运营、行政、项目执行、合规、数据整理、质量管理等需要严谨与稳定性的岗位。"
      relation="ISTJ 在关系中通常慢热但可靠，不轻易承诺，但承诺了就会认真履行。他们重视长期一致，而不是短暂热情。"
      love="恋爱中的 ISTJ 常常务实、稳定、低调，可能不擅长花哨表达，但会通过守时、负责、兑现和长期陪伴来体现重视。"
      stress="当压力过大时，ISTJ 可能变得更紧绷、更固执，也更难接受临时变化。提前规划、保留缓冲、逐项处理，会比硬扛更有效。"
      ;;
  esac

  render_page "$code"
  echo "written types/$(printf "%s" "$code" | tr '[:upper:]' '[:lower:]').html"
done
